{
	"name": "roo-plugin-example",
	"displayName": "Roo Plugin Example",
	"description": "Demonstrates the Roo Code plugin API: tool registration, context subscription, and agent messaging.",
	"version": "0.0.1",
	"publisher": "example",
	"engines": {
		"vscode": "^1.95.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"extensionDependencies": [
		"RooVeterinaryInc.roo-cline"
	],
	"main": "./out/extension.js",
	"contributes": {
		"roo-code": {
			"displayName": "Roo Plugin Example",
			"description": "Example plugin that adds utilities and shows live agent context."
		},
		"views": {
			"roo-cline-ActivityBar": [
				{
					"type": "webview",
					"id": "roo-plugin-example.panel",
					"name": "Roo Plugin Demo"
				}
			]
		},
		"commands": [
			{
				"command": "roo-plugin-example.askDateTime",
				"title": "Roo: Ask Agent for Current Date & Time"
			},
			{
				"command": "roo-plugin-example.pingPanel",
				"title": "Roo Plugin: Ping Panel from Extension Host"
			},
			{
				"command": "roo-plugin-example.activateDemoProfile",
				"title": "Roo Plugin: Activate Demo Configuration Profile"
			}
		]
	},
	"scripts": {
		"compile": "node esbuild.mjs",
		"watch": "node esbuild.mjs --watch",
		"check-types": "tsc --noEmit",
		"prepackage": "node -e \"require('fs').mkdirSync('bin', {recursive: true})\"",
		"package": "node esbuild.mjs && vsce package --no-dependencies --allow-missing-repository --out bin/roo-plugin-example-0.0.1.vsix"
	},
	"dependencies": {
		"@roo-code/plugin-api": "workspace:^"
	},
	"devDependencies": {
		"@roo-code/types": "workspace:^",
		"@types/node": "20.x",
		"@types/vscode": "^1.95.0",
		"@vscode/vsce": "^3.7.1",
		"esbuild": "^0.25.0",
		"typescript": "^5.7.0"
	}
}
